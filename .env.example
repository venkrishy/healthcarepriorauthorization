# AuthAgent Environment Variables
# Copy to .env and fill in values after CDK deployment.
# NEVER commit .env to git. Use dotenvx or AWS Secrets Manager in production.

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default  # or set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
KNOWLEDGE_BASE_ID=                 # output from cdk deploy AuthAgentData

# DynamoDB Tables (outputs from cdk deploy AuthAgentData)
DECISIONS_TABLE=authagent-decisions
AUDIT_TABLE=authagent-audit
RATE_LIMITS_TABLE=authagent-rate-limits

# Rate Limits
DAILY_REQUEST_LIMIT=100
MONTHLY_REQUEST_LIMIT=3100

# AgentCore Runtime (output from scripts/deploy_agentcore.py)
AGENTCORE_RUNTIME_ARN=

# API
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# Local dev: run graph inline instead of invoking AgentCore
RUN_INLINE=true

# OpenTelemetry
OTEL_SERVICE_NAME=authagent
OTEL_EXPORTER_OTLP_ENDPOINT=      # leave empty for stdout in dev
